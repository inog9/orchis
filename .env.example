# Nilai non-rahasia untuk `docker compose`. Rahasia (password DB, token, kunci) TIDAK ada di sini:
# semuanya dibuat acak oleh `sudo make prod-init` di direktori ORCHIS_STATE (di luar checkout, izin 0600).
#
# Cara mengisi (disarankan, tanpa edit manual):
#   sudo make prod-init                         # buat rahasia + nilai jaringan; admin awal ada di $ORCHIS_STATE/initial-admin.json
#   python3 deploy/prod/ops.py env > .env       # tulis berkas ini dari hasil init
#
# Contoh isi:
ORCHIS_STATE=/var/lib/orchis
ORCHIS_PROJECT=orchis-prod
ORCHIS_SITE=localhost
ORCHIS_BIND=127.0.0.1
ORCHIS_HTTPS_PORT=8443
ORCHIS_PROXY_SUBNET=172.29.0.0/24
ORCHIS_PROXY_RANGE=172.29.0.128/25
ORCHIS_CADDY_IP=172.29.0.10
