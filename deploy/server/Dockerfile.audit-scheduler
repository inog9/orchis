# Build the static server binary and web/dist before packaging. BASE_IMAGE must
# be an immutable tag of the running release, preserving other service binaries.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS backend
FROM scratch
COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend /usr/local/bin/ /usr/local/bin/
COPY --from=backend /opt/orchis/mitre/ /opt/orchis/mitre/
COPY --from=backend /licenses/ /licenses/
COPY --chmod=0555 build/server /usr/local/bin/server
COPY --chown=10001:10001 web/dist/ /web/
USER 10001:10001
ENV ORCHIS_HTTP_ADDR=0.0.0.0:8090 ORCHIS_WEB_DIR=/web
EXPOSE 8090
HEALTHCHECK --interval=15s --timeout=5s CMD ["/usr/local/bin/server", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/server"]
CMD ["serve"]
