{
 admin off
 default_sni {$ORCHIS_SITE:localhost}
 {$ORCHIS_AUTO_HTTPS:auto_https disable_redirects}
}
{$ORCHIS_SITE:localhost} {
 {$ORCHIS_TLS:tls internal}
 encode zstd gzip
 request_body {
  max_size 17MB
 }
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  X-Frame-Options DENY
  Referrer-Policy no-referrer
  -Server
 }
 # HTML dan rute aplikasi (mis. /assets/agents) selalu divalidasi ulang agar rilis baru langsung terlihat;
 # hanya berkas ber-ekstensi di /assets/ (hasil build ber-hash) yang aman di-cache lama.
 @hashed path_regexp ^/assets/[^/]+\.[A-Za-z0-9]+$
 header @hashed >Cache-Control "public, max-age=31536000, immutable"
 @page {
  not path_regexp ^/assets/[^/]+\.[A-Za-z0-9]+$
  not path /api/*
 }
 header @page >Cache-Control "no-cache"
 # Root CA of this installation, fetched by install.sh and accepted only when its SHA-256 matches the pinned fingerprint.
 handle /ca.pem {
  root * /data/caddy/pki/authorities/local
  rewrite * /root.crt
  file_server
 }
 handle {
  reverse_proxy server:8090
 }
}
