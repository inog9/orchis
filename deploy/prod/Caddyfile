{
 admin off
 auto_https disable_redirects
}
{$ORCHIS_SITE:localhost} {
 tls internal
 encode zstd gzip
 request_body {
  max_size 17MB
 }
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  X-Frame-Options DENY
  Referrer-Policy no-referrer
  -Server
 }
 # Root CA of this installation, fetched by install.sh and accepted only when its SHA-256 matches the pinned fingerprint.
 handle /ca.pem {
  root * /data/caddy/pki/authorities/local
  rewrite * /root.crt
  file_server
 }
 handle {
  reverse_proxy server:8090
 }
}
