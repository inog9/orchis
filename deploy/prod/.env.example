# Copy outside the checkout. prod-init generates the real values and secret files.
ORCHIS_STATE=/var/lib/orchis
ORCHIS_PROJECT=orchis-prod
ORCHIS_BIND=127.0.0.1
ORCHIS_HTTPS_PORT=8443
ORCHIS_SITE=localhost
# Default is internal TLS. For a public domain replace `tls internal` in a reviewed
# Caddyfile, publish ports 80/443 and configure DNS before enabling ACME.

# Optional local monitoring (export when running ops.py):
# COMPOSE_PROFILES=ops
# ORCHIS_GRAFANA_PORT=3000
