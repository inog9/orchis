[
  {
    "key": "nmap.tcp_connect",
    "adapter": "nmap",
    "integration": "nmap",
    "name": "Nmap TCP connect scan",
    "kind": "scan",
    "output_types": [
      "open_port",
      "service"
    ],
    "timeout_seconds": 600,
    "description": "Finds open TCP ports and, optionally, the service behind each port. Uses a full TCP connect (no raw packets).",
    "version": 1,
    "needs_agent": false,
    "category": "Network",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "label": "Ports",
          "enum": [
            "top100",
            "top1000",
            "web",
            "custom"
          ],
          "enum_labels": [
            "Top 100 ports",
            "Top 1000 ports",
            "Web ports (80, 443, 8000, 8080, 8443)",
            "Custom list"
          ],
          "default": "top100"
        },
        "ports": {
          "type": "string",
          "label": "Port list",
          "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?(,[0-9]{1,5}(-[0-9]{1,5})?){0,49}$",
          "max_length": 600,
          "help": "Ports and ranges separated by commas.",
          "show_when": {
            "field": "profile",
            "value": "custom"
          },
          "error_message": "Use ports like 22,80,8000-8100 (at most 50 entries)."
        },
        "service_detection": {
          "type": "boolean",
          "label": "Detect services and versions",
          "default": false,
          "help": "Slower, and sends probes to every open port."
        }
      },
      "order": [
        "profile",
        "ports",
        "service_detection"
      ]
    }
  },
  {
    "key": "nuclei.scan",
    "adapter": "nuclei",
    "integration": "nuclei",
    "name": "Nuclei vulnerability scan",
    "kind": "vulnerability_scan",
    "output_types": [
      "vulnerability"
    ],
    "timeout_seconds": 900,
    "description": "Checks a web target against Nuclei templates and reports matching vulnerabilities and exposures.",
    "version": 1,
    "needs_agent": false,
    "category": "Network",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "array",
          "label": "Severity to report",
          "items_enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "min_items": 1,
          "max_items": 5,
          "default": [
            "medium",
            "high",
            "critical"
          ]
        },
        "tags": {
          "type": "array",
          "label": "Template tags (optional)",
          "items_pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
          "max_items": 10,
          "default": [],
          "help": "Limit the scan to templates with these tags."
        },
        "template_profile": {
          "type": "string",
          "label": "Template profile",
          "enum": [
            "default",
            "exposure",
            "cves",
            "misconfig"
          ],
          "enum_labels": [
            "Default templates",
            "Exposure",
            "CVEs",
            "Misconfiguration"
          ]
        }
      },
      "order": [
        "severity",
        "tags",
        "template_profile"
      ]
    }
  },
